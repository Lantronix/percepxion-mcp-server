# === Percepxion MCP Server Configuration ===

# Production API (default). Set to https://api.gopercepxion.ai/api for the
# Lantronix sandbox/lab environment used internally.
PERCEPXION_API_URL=https://api.percepxion.ai/api

# Percepxion login credentials
PERCEPXION_USERNAME=username
PERCEPXION_PASSWORD=password

# Optional: default organization when callers omit organization_id
PERCEPXION_DEFAULT_ORGANIZATION_ID=

# Deprecated alias for PERCEPXION_DEFAULT_ORGANIZATION_ID above, kept for backward
# compatibility. Still works if set; the new variable wins if both are set.
PERCEPXION_DEFAULT_TENANT_ID=

# Optional: restrict firmware uploads to files within this directory
PERCEPXION_FIRMWARE_DIR=

# Optional: request timeout in seconds (default 45)
PERCEPXION_REQUEST_TIMEOUT=45

# --- CLI Command Policy ---
# PERCEPXION_CLI_WRITE_ENABLED: set to true to allow non-read-only commands (default: false)
PERCEPXION_CLI_WRITE_ENABLED=false

# PERCEPXION_CLI_YOLO: set to true to disable all command filtering (default: false)
# Requires PERCEPXION_CLI_WRITE_ENABLED=true. Use with extreme caution.
PERCEPXION_CLI_YOLO=false

# PERCEPXION_CLI_MAX_LENGTH: max chars per command (default: 512)
PERCEPXION_CLI_MAX_LENGTH=512

# PERCEPXION_CLI_DENY_COMMANDS: comma-separated commands to block in addition to built-in defaults
# Example: PERCEPXION_CLI_DENY_COMMANDS=clear counters,debug ip packet
PERCEPXION_CLI_DENY_COMMANDS=

# PERCEPXION_CLI_PERMIT_COMMANDS: comma-separated explicit allowlist. If set, only these
# commands are permitted (read-only commands still pass in read-only mode).
# Leave empty to allow all non-denied commands.
PERCEPXION_CLI_PERMIT_COMMANDS=

# --- Credential Provider ---
# PERCEPXION_CREDENTIAL_PROVIDER: env (default), vault, aws, or cyberark
PERCEPXION_CREDENTIAL_PROVIDER=env

# For vault provider:
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=hvs.XXXX
# VAULT_SECRET_PATH=secret/data/percepxion

# For aws provider:
# AWS_SECRET_NAME=percepxion/credentials
# AWS_REGION=us-east-1

# For cyberark provider (CyberArk Central Credential Provider / AIM Web Service):
# CYBERARK_URL=https://cyberark.internal
# CYBERARK_APP_ID=PercepxionMCP
# CYBERARK_SAFE=PercepxionSafe
# CYBERARK_OBJECT=percepxion-admin-account
# Optional mTLS (both required to enable mutual TLS):
# CYBERARK_CERT_PATH=/path/to/client.pem
# CYBERARK_KEY_PATH=/path/to/client.key
# Optional: set to false to skip server cert verification (lab use only)
# CYBERARK_VERIFY_SSL=true
