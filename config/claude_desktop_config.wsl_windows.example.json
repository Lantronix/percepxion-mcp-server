{
  "mcpServers": {
    "percepxion": {
      "command": "wsl.exe",
      "args": [
        "bash",
        "-lc",
        "cd /path/to/percepxion-mcp-server && .venv/bin/python percepxion_mcp.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PERCEPXION_API_URL": "https://api.percepxion.ai/api",
        "PERCEPXION_USERNAME": "your-email@example.com",
        "PERCEPXION_PASSWORD": "your-password"
      }
    }
  }
}